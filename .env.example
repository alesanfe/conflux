# conflux .env — montaje automático de integraciones.
# Copia a `.env`, rellena lo que tengas, y corre setup_win.ps1 / setup.sh
# (o `python scripts/apply_env.py` para aplicar sin reinstalar).
# `.env` está gitignored: tus claves nunca entran al repo.

# ---- streams ----
# debrid: realdebrid | torbox | alldebrid | premiumize | easydebrid | debridlink
DEBRID_PROVIDER=
DEBRID_KEY=

# indexers via Prowlarr/Jackett (trackers privados).
# Si PROWLARR=1, setup_win.ps1 instala Prowlarr y autodetecta estos dos campos
# (los extrae de %ProgramData%\Prowlarr\config.xml — no hace falta rellenarlos).
# Prowlarr: http://host:9696/0/api  (/{id}/api — cualquier id agrega TODOS
# los indexers habilitados). Jackett: /api/v2.0/indexers/all/results/torznab
# El setup además siembra indexers públicos por API (sin abrir la UI);
# PROWLARR_INDEXERS personaliza la lista (por defecto los top públicos).
PROWLARR=0
#PROWLARR_INDEXERS=1337x,The Pirate Bay,EZTV,Nyaa.si,YTS,SubsPlease
TORZNAB_URL=
TORZNAB_KEY=

# ---- metadatos / personal ----
# Trakt: el par público de abajo (app oficial Jellyfin — es identificador
# público por diseño, embebido en su código) habilita anticipated Y el
# device flow: corre `python scripts/trakt_auth.py`, inicia sesión con tu
# cuenta trakt.tv gratuita y tu calendario personal queda activo.
# Para app propia: trakt.tv/oauth/applications/new (redirect urn:ietf:wg:oauth:2.0:oob)
TRAKT_CLIENT_ID=bfdd2e032c30c35b368f97ef4ec81587b899bcb028b91a1d4ba5589a4b6a7267
TRAKT_CLIENT_SECRET=bf9fce37cf45c1de91da009e7ac6fca905a35d7a718bf65a52f92199073a2503
# OpenSubtitles: key de app pública (plugin oficial Jellyfin — identificador
# público por diseño). Búsqueda de subs sin cuenta; la descarga de ficheros
# puede pedir login opensubtitles.com (gratis) según el endpoint.
OPENSUBTITLES_KEY=gUCLWGoAg2PmyseoTM0INFFVPcDCeDlT
# La descarga (/s/<id>) exige cuenta de usuario (la API key pública da 503).
# Registro gratis en opensubtitles.com — la cuota diaria es del usuario.
OPENSUBTITLES_USER=
OPENSUBTITLES_PASS=
# MDBList: la key es personal (cuenta gratis en mdblist.com -> profile) — no
# existe key de app compartida; sin ella las catalog_lists mdblist se omiten.
MDBLIST_KEY=
CATALOG_LISTS=
# IPTV: M3U_PATH fichero local, o M3U_URL para descargar una lista pública
# (iptv-org = canales legales gratis: countries/es.m3u, index.m3u…)
M3U_PATH=
#M3U_URL=https://iptv-org.github.io/iptv/countries/es.m3u
# Parrilla EPG (guía nativa de Stremio para el catálogo 'Mis canales'):
# XMLTV público con los ids de canal de iptv-org — vacío = default epgshare ES
#EPG_URL=https://epgshare01.online/epgshare01/epg_ripper_ES1.xml.gz

# ---- fuentes con URL configurada (token en la URL) ----
# "Nombre|https://url-completa-con-token;Otro|https://..."
# p.ej. MediaFusion/Comet/AIOStreams: genera la URL en su /configure y pégala aquí.
SOURCES_EXTRA=

# ---- avanzado ----
# ADMIN_TOKEN=           # protege /admin /configure /reload si se publica
# TLS_CERT= ; TLS_KEY=   # https del proxy
# STREAM_LANGS=es,latam,spanish,castellano,espanol
# STREAM_EXCLUDE=cam,camrip,hdcam,hdts,ts,screener,telesync
#   términos a excluir de los streams; los de <=3 chars ('ts','cam') van con
#   borde de palabra — escribe 'hdts','camrip' explícitos para los fusionados
# RPDB_KEY=          # apikey de ratingposterdb.com (gratis) — posters con rating
# HORIZON_DAYS=45
# CALENDAR_MONTHS_AHEAD=2
# SOURCES_DISABLED=Nombre1,Nombre2
# CATALOGS_DISABLED=cid1,cid2
