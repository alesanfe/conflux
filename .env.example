# conflux .env — montaje automático de integraciones.
# Copia a `.env`, rellena lo que tengas, y corre setup_win.ps1 / setup.sh
# (o `python scripts/apply_env.py` para aplicar sin reinstalar).
# `.env` está gitignored: tus claves nunca entran al repo.

# ---- streams ----
# debrid: realdebrid | torbox | alldebrid | premiumize | easydebrid | debridlink
DEBRID_PROVIDER=
DEBRID_KEY=

# indexers via Prowlarr/Jackett (trackers privados).
# Si PROWLARR=1, setup_win.ps1 instala Prowlarr y autodetecta estos dos campos
# (los extrae de %ProgramData%\Prowlarr\config.xml — no hace falta rellenarlos).
PROWLARR=0
TORZNAB_URL=http://127.0.0.1:9696/api/v1.0/indexers/all/results/torznab
TORZNAB_KEY=

# ---- metadatos / personal ----
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
OPENSUBTITLES_KEY=
MDBLIST_KEY=
CATALOG_LISTS=
M3U_PATH=

# ---- fuentes con URL configurada (token en la URL) ----
# "Nombre|https://url-completa-con-token;Otro|https://..."
# p.ej. MediaFusion/Comet/AIOStreams: genera la URL en su /configure y pégala aquí.
SOURCES_EXTRA=

# ---- avanzado ----
# ADMIN_TOKEN=           # protege /admin /configure /reload si se publica
# TLS_CERT= ; TLS_KEY=   # https del proxy
# STREAM_LANGS=es,latam,spanish,castellano,espanol
# HORIZON_DAYS=45
# CALENDAR_MONTHS_AHEAD=2
# SOURCES_DISABLED=Nombre1,Nombre2
# CATALOGS_DISABLED=cid1,cid2
